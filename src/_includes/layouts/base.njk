<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

  <header class="site-header">
    <div class="container container--wide">
      <a href="/" class="site-logo" aria-label="{{ site.name }} documentation home">
        <img src="/assets/img/logo.svg" alt="{{ site.name }}" height="36">
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/">Policies</a>
        <a href="{{ site.appUrl }}" target="_blank" rel="noopener noreferrer" class="site-nav__app-link">Go to app →</a>
      </nav>
    </div>
  </header>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container container--wide">
      <p>&copy; {{ "" | currentYear }} {{ site.name }}. All rights reserved.</p>
      <p>
        <a href="{{ site.appUrl }}" target="_blank" rel="noopener noreferrer">{{ site.appUrl }}</a>
      </p>
    </div>
  </footer>

</body>
</html>
